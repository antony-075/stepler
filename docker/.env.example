# Local development credentials only. Copy to docker/.env; never commit docker/.env.
POSTGRES_USER=stepler
POSTGRES_PASSWORD=stepler-local
POSTGRES_DB=stepler
# 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433
# S3 emulator (SeaweedFS) root credentials; the API uses the same pair locally.
S3_ACCESS_KEY_ID=stepler
S3_SECRET_ACCESS_KEY=stepler-local-secret
