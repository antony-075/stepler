{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:e2e": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist-e2e/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_SHADOW_DATABASE_URL",
        "TEST_SMTP_URL",
        "TEST_S3_ENDPOINT",
        "TEST_MAILPIT_URL",
        "RUN_NETWORK_TESTS"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docker/**"]
    },
    "e2e": {
      "dependsOn": ["@stepler/api#build:e2e", "@stepler/web#build", "db:generate"],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "API_PORT",
        "LOG_LEVEL",
        "PORT",
        "API_INTERNAL_URL",
        "CLIENT_IP_HEADER",
        "LEGAL_CONTACT_EMAIL",
        "LEGAL_ALLOW_DRAFT",
        "APP_ORIGIN",
        "DATABASE_URL",
        "COOKIE_SECURE",
        "SESSION_TTL_DAYS",
        "MAGIC_LINK_TTL_MINUTES",
        "OPERATOR_EMAILS",
        "API_TRUST_PROXY",
        "APP_SECRET",
        "SMTP_URL",
        "MAIL_FROM",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "LIMIT_MAGIC_LINK_PER_EMAIL_PER_HOUR",
        "LIMIT_MAGIC_LINK_PER_IP_PER_HOUR",
        "LIMIT_MAGIC_LINK_PREVIEW_PER_IP_PER_HOUR",
        "LIMIT_COLLECTION_CREATIONS_PER_DAY",
        "LIMIT_GUEST_LINK_RESOLVE_PER_IP_PER_MINUTE",
        "LIMIT_GUEST_SESSIONS_PER_IP_PER_MINUTE",
        "LIMIT_FILE_BYTES_PHOTO",
        "LIMIT_FILE_BYTES_VIDEO",
        "LIMIT_FILE_BYTES_DOCUMENT",
        "LIMIT_FILES_PER_BATCH",
        "LIMIT_TEXTS_PER_GUEST_SESSION_PER_HOUR",
        "LIMIT_UPLOAD_INITIATIONS_PER_GUEST_SESSION_PER_HOUR",
        "LIMIT_CONCURRENT_UPLOADS_PER_GUEST_SESSION",
        "UPLOAD_PART_SIZE_BYTES",
        "LIMIT_UPLOAD_CALLS_PER_IP_PER_MINUTE",
        "LIMIT_UPLOAD_CALLS_PER_GUEST_SESSION_PER_MINUTE",
        "LIMIT_ADMIN_COVER_CALLS_PER_IP_PER_MINUTE",
        "LIMIT_ADMIN_COVER_CALLS_PER_USER_PER_MINUTE",
        "S3_REQUEST_TIMEOUT_MS",
        "S3_COMPLETE_TIMEOUT_MS",
        "UPLOAD_SESSION_TTL_HOURS",
        "UPLOAD_URL_TTL_SECONDS",
        "MEDIA_URL_WINDOW_SECONDS",
        "LIMIT_TEXTS_PER_IP_PER_MINUTE",
        "LIMIT_GUEST_READS_PER_IP_PER_MINUTE",
        "LIMIT_GUEST_WRITES_PER_IP_PER_MINUTE",
        "LIMIT_REPORTS_PER_IP_PER_HOUR",
        "LIMIT_REPORTS_PER_GUEST_SESSION_PER_HOUR",
        "LIMIT_APPEALS_PER_ACCOUNT_PER_DAY",
        "MODERATION_QUARANTINE_DAYS",
        "BILLING_PROVIDER",
        "LIQPAY_PUBLIC_KEY",
        "LIQPAY_PRIVATE_KEY",
        "LIQPAY_API_BASE",
        "BILLING_CALLBACK_URL",
        "BILLING_PENDING_TTL_MINUTES",
        "BILLING_FISCAL_MODE",
        "BILLING_FISCAL_WAIVED",
        "LIMIT_BILLING_CALLBACKS_PER_IP_PER_MINUTE",
        "LIMIT_BILLING_CHECKOUTS_PER_USER_PER_HOUR",
        "WORKER_MEDIA_CONCURRENCY",
        "WORKER_PURGE_BATCH_SIZE",
        "GUEST_SESSION_IDLE_DAYS",
        "E2E_DATABASE_URL",
        "E2E_MAILPIT_URL",
        "E2E_SMTP_URL",
        "E2E_S3_ENDPOINT",
        "E2E_API_PORT",
        "E2E_WEB_PORT"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "API_PORT",
        "LOG_LEVEL",
        "PORT",
        "API_INTERNAL_URL",
        "CLIENT_IP_HEADER",
        "LEGAL_CONTACT_EMAIL",
        "LEGAL_ALLOW_DRAFT",
        "APP_ORIGIN",
        "DATABASE_URL",
        "COOKIE_SECURE",
        "SESSION_TTL_DAYS",
        "MAGIC_LINK_TTL_MINUTES",
        "OPERATOR_EMAILS",
        "API_TRUST_PROXY",
        "APP_SECRET",
        "SMTP_URL",
        "MAIL_FROM",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "LIMIT_MAGIC_LINK_PER_EMAIL_PER_HOUR",
        "LIMIT_MAGIC_LINK_PER_IP_PER_HOUR",
        "LIMIT_MAGIC_LINK_PREVIEW_PER_IP_PER_HOUR",
        "LIMIT_COLLECTION_CREATIONS_PER_DAY",
        "LIMIT_GUEST_LINK_RESOLVE_PER_IP_PER_MINUTE",
        "LIMIT_GUEST_SESSIONS_PER_IP_PER_MINUTE",
        "LIMIT_FILE_BYTES_PHOTO",
        "LIMIT_FILE_BYTES_VIDEO",
        "LIMIT_FILE_BYTES_DOCUMENT",
        "LIMIT_FILES_PER_BATCH",
        "LIMIT_TEXTS_PER_GUEST_SESSION_PER_HOUR",
        "LIMIT_UPLOAD_INITIATIONS_PER_GUEST_SESSION_PER_HOUR",
        "LIMIT_CONCURRENT_UPLOADS_PER_GUEST_SESSION",
        "UPLOAD_PART_SIZE_BYTES",
        "LIMIT_UPLOAD_CALLS_PER_IP_PER_MINUTE",
        "LIMIT_UPLOAD_CALLS_PER_GUEST_SESSION_PER_MINUTE",
        "LIMIT_ADMIN_COVER_CALLS_PER_IP_PER_MINUTE",
        "LIMIT_ADMIN_COVER_CALLS_PER_USER_PER_MINUTE",
        "S3_REQUEST_TIMEOUT_MS",
        "S3_COMPLETE_TIMEOUT_MS",
        "UPLOAD_SESSION_TTL_HOURS",
        "UPLOAD_URL_TTL_SECONDS",
        "MEDIA_URL_WINDOW_SECONDS",
        "LIMIT_TEXTS_PER_IP_PER_MINUTE",
        "LIMIT_GUEST_READS_PER_IP_PER_MINUTE",
        "LIMIT_GUEST_WRITES_PER_IP_PER_MINUTE",
        "LIMIT_REPORTS_PER_IP_PER_HOUR",
        "LIMIT_REPORTS_PER_GUEST_SESSION_PER_HOUR",
        "LIMIT_APPEALS_PER_ACCOUNT_PER_DAY",
        "MODERATION_QUARANTINE_DAYS",
        "BILLING_PROVIDER",
        "LIQPAY_PUBLIC_KEY",
        "LIQPAY_PRIVATE_KEY",
        "LIQPAY_API_BASE",
        "BILLING_CALLBACK_URL",
        "BILLING_PENDING_TTL_MINUTES",
        "BILLING_FISCAL_MODE",
        "BILLING_FISCAL_WAIVED",
        "LIMIT_BILLING_CALLBACKS_PER_IP_PER_MINUTE",
        "LIMIT_BILLING_CHECKOUTS_PER_USER_PER_HOUR"
      ]
    },
    "worker:dev": {
      "dependsOn": ["^build", "db:generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "LOG_LEVEL",
        "DATABASE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "WORKER_MEDIA_CONCURRENCY",
        "WORKER_PURGE_BATCH_SIZE",
        "GUEST_SESSION_IDLE_DAYS",
        "UPLOAD_URL_TTL_SECONDS",
        "S3_REQUEST_TIMEOUT_MS",
        "S3_COMPLETE_TIMEOUT_MS",
        "APP_ORIGIN",
        "SMTP_URL",
        "MAIL_FROM",
        "OPERATOR_EMAILS",
        "LEGAL_CONTACT_EMAIL",
        "REPORT_EMAIL_RETENTION_DAYS",
        "READ_ONLY_RETENTION_MONTHS",
        "BILLING_RETENTION_DELETE_ENABLED",
        "BILLING_PROVIDER",
        "LIQPAY_PUBLIC_KEY",
        "LIQPAY_PRIVATE_KEY",
        "LIQPAY_API_BASE",
        "BILLING_CALLBACK_URL",
        "BILLING_PENDING_TTL_MINUTES",
        "BILLING_FISCAL_MODE",
        "BILLING_FISCAL_WAIVED"
      ]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
