{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "API_PORT",
        "LOG_LEVEL",
        "PORT",
        "API_INTERNAL_URL",
        "TRUST_PROXY_HEADERS"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "API_PORT",
        "LOG_LEVEL",
        "PORT",
        "API_INTERNAL_URL",
        "TRUST_PROXY_HEADERS"
      ]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
