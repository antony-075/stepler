// Identity (spec §7.1), collections, guest links, guest sessions, content and audit (§7.2–§7.4). Constraints the schema cannot express (citext extension, CHECKs,
// partial indexes) live as named raw SQL in the migrations (ADR 0005, spike S6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uk
  en
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
  /// Deletion requested: gone for everyone; the purge job removes the rows (D2).
  DELETING
}

enum GuestLinkStatus {
  ACTIVE
  /// Paused by the admin; can be resumed.
  INACTIVE
  /// Terminal: revoked, or rotated out (a default link). The token ciphertext is wiped.
  REVOKED
}

enum ContentKind {
  PHOTO
  VIDEO
  DOCUMENT
  TEXT
}

/// TEXT and DOCUMENT are NOT_REQUIRED; PHOTO and VIDEO stay PENDING until the worker finishes
/// (CHECK "ContentItem_processing_by_kind").
enum ProcessingStatus {
  NOT_REQUIRED
  PENDING
  READY
  FAILED
}

/// What an upload becomes: a guest's content frame, or one of the admin's images: the guest page
/// cover, its background, or the admin-only collection image [A1]
/// (CHECKs "UploadSession_purpose_actor", "UploadSession_admin_image_is_photo").
enum UploadPurpose {
  CONTENT
  COVER
  BACKGROUND
  COLLECTION_IMAGE
}

/// Which admin image an image row is (plan 2026-10-05, ADR 0017). The slot decides its storage
/// prefix and its renditions; rows are referenced by guest page versions or the collection.
enum ImageSlot {
  COVER
  BACKGROUND
  COLLECTION_IMAGE
}

/// PENDING until the worker made its renditions (CHECK "CollectionImage_ready_dimensions").
enum ImageStatus {
  PENDING
  READY
  FAILED
}

/// Where an image's original came from: the admin's own upload, or a copy of a guest photo frame.
enum ImageSource {
  UPLOAD
  FRAME
}

/// A collection has one PUBLISHED guest page (what guests see) and at most one DRAFT (the editor's).
enum GuestPageVersionState {
  PUBLISHED
  DRAFT
}

/// What an admin image upload completes into, fixed at initiation (CHECK
/// "UploadSession_image_target"): the draft's cover or background, or the collection image. A
/// route completes only its own. `LEGACY_COVER` (the slice 8a cover routes, removed in PR J) is
/// no longer written; its open uploads cannot complete and expire. The value stays (PR L): every
/// cover upload from before PR I keeps it (upload rows live as long as their collection), and
/// removing it would mean relabelling those rows with a target they never had.
enum ImageUploadTarget {
  DRAFT
  LEGACY_COVER
  COLLECTION
}

enum UploadStatus {
  INITIATED
  /// A completion claimed it (`claimedAt`) and is checking storage outside any transaction; a
  /// claim older than a few minutes (a crashed completion) can be claimed again or expired.
  COMPLETING
  COMPLETED
  /// Cancelled by the guest, or by the collection's purge.
  ABORTED
  /// Not completed within its TTL; the expiry job discards its bytes.
  EXPIRED
  /// Completion refused (type, size, permission or state); the bytes are discarded.
  REJECTED
}

enum MediaRole {
  ORIGINAL
  THUMBNAIL
  PREVIEW
  POSTER
}

enum AuditActorType {
  ADMIN
  OPERATOR
  GUEST
  SYSTEM
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

/// Why a guest reported a frame (R1; contracts `REPORT_REASONS`).
enum ReportReason {
  ILLEGAL
  INAPPROPRIATE
  PRIVACY
  SPAM
  OTHER
}

/// OPEN until the operator decides; the decision covers every open report on the item ([P2]).
enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// Who hid a frame from guests: its admin, or the Stepler operator (the admin cannot undo that).
enum HiddenBy {
  ADMIN
  OPERATOR
}

/// What a collection admin appeals (slice 9b): a frame the operator hid or quarantined, or the
/// blocked collection itself.
enum AppealTargetType {
  CONTENT
  COLLECTION
}

/// OPEN until the operator decides; UPHELD reverses the measure, REJECTED keeps it (with a note).
enum AppealStatus {
  OPEN
  UPHELD
  REJECTED
}

/// Legal documents (registry in @stepler/contracts `LEGAL_DOCUMENTS`; ADR 0016).
/// Billing (ADR 0018).
enum OfferKind {
  TRIAL
  PACK
  PACK_EXTENSION
  SUBSCRIPTION
}

enum PackExtensionKind {
  WINDOW
  RETENTION
  STORAGE
}

enum BillingInterval {
  ONE_TIME
  MONTH
  YEAR
}

enum Currency {
  UAH
  EUR
  USD
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionSource {
  LIQPAY
  COMPLIMENTARY
}

/// What a payment buys (plan Task 11). Renewals are separate rows [P9].
enum PaymentKind {
  PACK
  PACK_EXTENSION
  SUBSCRIPTION
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_CHANGE
}

/// Written only by `PaymentTransitions` (and refunds, M4); final states never regress except
/// SUCCEEDED → REVERSED.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REVERSED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// A manual refund from /ops (plan Task 21): PENDING until LiqPay answers (a crash or timeout is
/// resolved by the reconcile job through `status`).
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// ACCOUNT = the account's plan or trial governs it; PACK = its own pack does (plan [P1]).
enum CollectionEntitlement {
  ACCOUNT
  PACK
}

enum LegalDocument {
  TERMS
  PRIVACY
}

model User {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email              String            @unique @db.Citext
  emailVerifiedAt    DateTime?         @db.Timestamptz(3)
  /// At most 80 characters (CHECK "User_displayName_length").
  displayName        String?
  locale             Locale            @default(uk)
  /// BLOCKED if and only if blockedAt is set (CHECK "User_blocked_consistent").
  status             UserStatus        @default(ACTIVE)
  blockedAt          DateTime?         @db.Timestamptz(3)
  blockedReason      String?
  /// The trial's end (ADR 0018 [B7]): set once, on account creation; never renewed.
  trialEndsAt        DateTime?         @db.Timestamptz(3)
  /// When the «лише перегляд» mail went out for the current read-only episode (plan Task 6);
  /// cleared by the retention clock when access returns, so a later episode mails again.
  readOnlyNotifiedAt DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  subscriptions      Subscription[]
  payments           Payment[]
  refundsMade        Refund[]
  accounts           AuthAccount[]
  sessions           AuthSession[]
  collections        Collection[]
  uploadSessions     UploadSession[]
  legalAcceptances   LegalAcceptance[]
}

model AuthAccount {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One acceptance of one version of a legal document (spec §7.1, ADR 0016). No IP address is
/// stored (owner decision L2); `requestId` correlates the row with the request log. The version
/// is one of the registry's (CHECK "LegalAcceptance_version_format").
model LegalAcceptance {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String        @db.Uuid
  document   LegalDocument
  version    String
  acceptedAt DateTime      @default(now()) @db.Timestamptz(3)
  requestId  String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
}

model MagicLinkToken {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String    @db.Citext
  /// SHA-256 of the emailed token; the raw token is never stored.
  tokenHash           String    @unique
  expiresAt           DateTime  @db.Timestamptz(3)
  consumedAt          DateTime? @db.Timestamptz(3)
  locale              Locale
  /// HMAC-SHA256 of the requesting IP (HKDF key "ip-hash"); for abuse investigation only.
  requestIpHash       String?
  /// Legal versions accepted on the sign-in card (ADR 0016), recorded at verify. NULL on links
  /// issued before slice 10 (nothing is recorded). CHECK "MagicLinkToken_legal_versions_format".
  legalTermsVersion   String?
  legalPrivacyVersion String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
}

model Collection {
  id                  String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId             String                @db.Uuid
  /// 1 to 100 characters (CHECK "Collection_title_length").
  title               String
  /// 1 to 1000 characters when set (CHECK "Collection_description_length").
  description         String?
  /// ARCHIVED iff archivedAt is set, DELETING iff deletionRequestedAt is set
  /// (CHECKs "Collection_archived_consistent", "Collection_deleting_consistent").
  status              CollectionStatus      @default(ACTIVE)
  archivedAt          DateTime?             @db.Timestamptz(3)
  deletionRequestedAt DateTime?             @db.Timestamptz(3)
  /// Blocked by the Stepler operator (R7): closed to guests, the owner cannot unblock it. Both
  /// set or both NULL (CHECK "Collection_blocked_consistent"); the reason is the operator's,
  /// 1 to 500 characters (CHECK "Collection_blocked_reason_length").
  blockedAt           DateTime?             @db.Timestamptz(3)
  blockedReason       String?
  /// The next frame number (ADR 0015); taken and incremented in the transaction that creates an
  /// item. Gaps are never filled. At least 1 (CHECK "Collection_next_frame_positive").
  nextFrameNo         Int                   @default(1)
  /// The highest guest page revision handed out (a new draft and every save take the next one),
  /// so a revision names one draft state for the life of the collection, across publishes and
  /// resets. At least 1 (CHECK "Collection_page_revision_positive").
  lastPageRevision    Int                   @default(1)
  /// Which entitlement governs it (ADR 0018 [P1]); PACK iff it has a CollectionPack.
  entitlement         CollectionEntitlement @default(ACCOUNT)
  /// Read-only content is deleted after this (plan [P5]); set and cleared by the worker's
  /// retention clock. The warning stamps need it (CHECK "Collection_deletion_warnings").
  deleteAfter         DateTime?             @db.Timestamptz(3)
  deletionWarnedAt30  DateTime?             @db.Timestamptz(3)
  deletionWarnedAt7   DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  guestLinks          GuestLink[]
  guestSessions       GuestSession[]
  contentItems        ContentItem[]
  uploadSessions      UploadSession[]
  /// «Картинка колекції»: the owner's own image of the collection (dashboard, share dialog);
  /// never in a guest response. An image of this collection (composite key), NO ACTION so
  /// deleting the collection still cascades in one statement.
  imageId             String?               @db.Uuid
  image               CollectionImage?      @relation("CollectionImageOfCollection", fields: [imageId, id], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "Collection_image_same_collection_fkey")
  images              CollectionImage[]     @relation("CollectionImages")
  guestPageVersions   GuestPageVersion[]
  pack                CollectionPack?
  payments            Payment[]

  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)])
}

/// An admin image of a collection (plan 2026-10-05, ADR 0017): a guest page cover or background,
/// or the collection image. Rows are immutable apart from the worker's READY/FAILED and its
/// location stripping (`sanitizedAt`/`sanitizeFailedAt`, `originalSizeBytes`); a replaced image
/// is a new row. A row lives while a guest page version or the collection references it; the
/// transaction that drops the last reference deletes it and queues `collection-image.purge`. Keys
/// come from ids only: `imageKey(collectionId, slot, id, role)`. Rules live as named CHECKs:
/// "CollectionImage_sizes", "CollectionImage_ready_dimensions".
model CollectionImage {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String             @db.Uuid
  slot              ImageSlot
  status            ImageStatus        @default(PENDING)
  source            ImageSource
  /// The verified type of the original (content signature), never the browser's claim.
  mimeType          String
  originalSizeBytes BigInt
  /// Every rendition of the slot; 0 until READY. They count toward usage with the original.
  derivedSizeBytes  BigInt             @default(0)
  /// When the worker removed location metadata from the original (ADR 0008 addendum
  /// 2026-10-05), before its renditions; `originalSizeBytes` is the sanitised size from then.
  sanitizedAt       DateTime?          @db.Timestamptz(3)
  /// When the worker gave up on sanitising; the backfill skips it. CHECK
  /// "CollectionImage_sanitize_outcome".
  sanitizeFailedAt  DateTime?          @db.Timestamptz(3)
  /// The source's upright dimensions, set with READY.
  width             Int?
  height            Int?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  collection        Collection         @relation("CollectionImages", fields: [collectionId], references: [id], onDelete: Cascade)
  asCollectionImage Collection[]       @relation("CollectionImageOfCollection")
  asCover           GuestPageVersion[] @relation("GuestPageCover")
  asBackground      GuestPageVersion[] @relation("GuestPageBackground")

  @@unique([id, collectionId])
  @@index([collectionId, slot])
}

/// One version of a collection's guest page (plan 2026-10-05, ADR 0017): the PUBLISHED one guests
/// see and, while the admin edits, one DRAFT ("GuestPageVersion_collectionId_state_key"). Settings
/// are validated by the template's definition before they are stored, and resolved again on read.
/// The images belong to the same collection (composite keys, NO ACTION). `revision` is the
/// draft's optimistic-concurrency counter. Rules live as named CHECKs:
/// "GuestPageVersion_template_id", "GuestPageVersion_numbers",
/// "GuestPageVersion_settings_object", "GuestPageVersion_welcome_length".
model GuestPageVersion {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String                @db.Uuid
  state             GuestPageVersionState
  templateId        String
  templateVersion   Int
  settings          Json
  /// Shown to guests above their main action; 1 to 160 code points when set [A5].
  welcomeMessage    String?
  coverImageId      String?               @db.Uuid
  backgroundImageId String?               @db.Uuid
  /// From `Collection.lastPageRevision`; a published version keeps the revision it was published at.
  revision          Int                   @default(1)
  /// Set when the editor (or a legacy route) first saves the draft; NULL while it only holds what
  /// it was copied from plus image changes, so a first save with `baseRevision: null` may take it.
  savedAt           DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  collection        Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  coverImage        CollectionImage?      @relation("GuestPageCover", fields: [coverImageId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "GuestPageVersion_cover_same_collection_fkey")
  backgroundImage   CollectionImage?      @relation("GuestPageBackground", fields: [backgroundImageId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "GuestPageVersion_background_same_collection_fkey")

  @@unique([collectionId, state])
  @@index([coverImageId])
  @@index([backgroundImageId])
}

/// A public entry point to a collection (ADR 0007, spec §7.2). Rules live as named CHECKs:
/// "GuestLink_has_capability", "GuestLink_delete_own_needs_contribution",
/// "GuestLink_revoked_consistent", "GuestLink_ciphertext_while_live",
/// "GuestLink_replaced_only_revoked", "GuestLink_label_rules",
/// "GuestLink_hidden_only_revoked_additional"; at most one non-revoked default
/// link per collection (partial unique index "GuestLink_one_live_default").
model GuestLink {
  id                 String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId       String          @db.Uuid
  isDefault          Boolean
  /// Additional links only, 1 to 60 characters; the default link has none.
  label              String?
  status             GuestLinkStatus @default(ACTIVE)
  revokedAt          DateTime?       @db.Timestamptz(3)
  /// Set when the owner deletes an additional link: revoked and no longer listed. The row stays,
  /// so audit events and (later) guest content keep pointing at it.
  hiddenAt           DateTime?       @db.Timestamptz(3)
  /// Set on a rotated-out default link: the link that replaced it.
  replacedById       String?         @unique @db.Uuid
  /// SHA-256 of the token, for lookup. The raw token is never stored in clear.
  tokenHash          String          @unique
  /// AES-256-GCM of the token so the owner can see the link again; NULL once revoked.
  tokenCiphertext    String?
  tokenKeyId         String?
  canUploadPhotos    Boolean
  canUploadVideos    Boolean
  canUploadDocuments Boolean
  canSubmitText      Boolean
  canViewGallery     Boolean
  canDeleteOwn       Boolean
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  collection         Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  replacedBy         GuestLink?      @relation("LinkRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces           GuestLink?      @relation("LinkRotation")
  guestSessions      GuestSession[]
  uploadSessions     UploadSession[]

  @@unique([id, collectionId])
  @@index([collectionId, isDefault, status, createdAt])
}

/// A guest's browser in one collection (ADR 0007, spec §7.2): the `st_gs` cookie holds the raw
/// token. Bound to the link it last came through; every request re-checks that link and the
/// collection. The name is optional, asked once [O4]; 1 to 80 characters when set
/// (CHECK "GuestSession_name_length").
model GuestSession {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId    String          @db.Uuid
  /// A link of the same collection (composite key with "collectionId"). A link with sessions is
  /// never deleted (links are revoked and hidden instead). NO ACTION, not RESTRICT, so deleting
  /// the collection still cascades to both in one statement.
  currentLinkId   String          @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash       String          @unique
  contributorName String?
  /// Set when the guest saved or skipped the name prompt, so it is asked once per session.
  nameAnsweredAt  DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime        @default(now()) @db.Timestamptz(3)
  collection      Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  currentLink     GuestLink       @relation(fields: [currentLinkId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "GuestSession_link_same_collection_fkey")
  contentItems    ContentItem[]
  uploadSessions  UploadSession[]

  @@unique([id, collectionId])
  @@index([collectionId])
  @@index([currentLinkId])
}

/// One frame: a text now, files later (spec §7.3). Rules live as named CHECKs:
/// "ContentItem_text_consistent", "ContentItem_text_length", "ContentItem_name_length",
/// "ContentItem_frame_positive", "ContentItem_processing_by_kind"; the feed, own and purge
/// indexes are partial ("ContentItem_feed_idx", "ContentItem_feed_kind_idx",
/// "ContentItem_own_idx", "ContentItem_deleted_idx").
model ContentItem {
  id                        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId              String           @db.Uuid
  /// Per-collection number shown as #086 (ADR 0015); never reused.
  frameNo                   Int
  kind                      ContentKind
  /// A session of the same collection (composite key with "collectionId"); only this column is
  /// nulled once the session row is gone (`SET NULL ("contributorGuestSessionId")` in the
  /// migration; Prisma warns about SetNull on a key with a required field). The item stays.
  contributorGuestSessionId String?          @db.Uuid
  /// Snapshot of the session's name when the item was created; renaming updates live items [C4].
  contributorName           String?
  originalFilename          String?
  /// TEXT items only, 1 to 5000 code points.
  textBody                  String?
  /// The client's `Idempotency-Key` for texts; unique per session.
  idempotencyKey            String?          @db.Uuid
  processingStatus          ProcessingStatus
  /// PHOTO/VIDEO: when the worker removed location metadata from the original (ADR 0008
  /// addendum 2026-10-05); NULL until then, and the original is not served before it.
  /// CHECKs "ContentItem_sanitized_media_only", "ContentItem_sanitize_outcome"; the backfill
  /// reads "ContentItem_unsanitized_idx".
  sanitizedAt               DateTime?        @db.Timestamptz(3)
  /// When the worker gave up on sanitising (a file it cannot rewrite, or its last retry): the
  /// original stays the admin's only, and the backfill skips the item.
  sanitizeFailedAt          DateTime?        @db.Timestamptz(3)
  /// Soft delete: hidden at once, purged by the worker.
  deletedAt                 DateTime?        @db.Timestamptz(3)
  /// Hidden from guests (slice 9): every guest read filters on it (`GUEST_VISIBLE`); the admin
  /// still sees the item. The three are set together (CHECK "ContentItem_hidden_consistent");
  /// an operator hide has a reason (CHECKs "ContentItem_operator_hide_reason",
  /// "ContentItem_hidden_reason_length"). `hiddenByUserId` has no FK: the audit trail outlives
  /// the account.
  hiddenAt                  DateTime?        @db.Timestamptz(3)
  hiddenBy                  HiddenBy?
  hiddenByUserId            String?          @db.Uuid
  hiddenReason              String?
  /// Deleted by the Stepler operator (slice 9b, Q-A1): invisible to guests and outside the
  /// quota at once, kept for its admin to see and appeal until `purgeAfter`, when the sweep
  /// soft-deletes it for the purge. `deletedAt` stays NULL meanwhile, so `content.purge` cannot
  /// touch it. The four are set together (CHECK "ContentItem_quarantine_consistent"); the reason
  /// is 1 to 500 characters (CHECK "ContentItem_quarantine_reason_length"); a quarantine replaces
  /// an operator hide (CHECK "ContentItem_quarantine_not_operator_hidden"), an admin hide stays.
  /// `quarantinedByUserId` has no FK. The sweep reads "ContentItem_quarantine_purge_idx".
  quarantinedAt             DateTime?        @db.Timestamptz(3)
  quarantinedByUserId       String?          @db.Uuid
  quarantineReason          String?
  purgeAfter                DateTime?        @db.Timestamptz(3)
  createdAt                 DateTime         @default(now()) @db.Timestamptz(3)
  collection                Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contributorGuestSession   GuestSession?    @relation(fields: [contributorGuestSessionId, collectionId], references: [id, collectionId], onDelete: SetNull, onUpdate: NoAction, map: "ContentItem_session_same_collection_fkey")
  mediaObjects              MediaObject[]
  uploadSession             UploadSession?

  @@unique([collectionId, frameNo])
  @@unique([contributorGuestSessionId, idempotencyKey])
}

/// A stored file of a content item (spec §7.3): the ORIGINAL as uploaded (sanitised once by the
/// worker, then immutable: ADR 0008 addendum 2026-10-05), and the derivatives the worker makes
/// (disposable). Sizes are positive (CHECK "MediaObject_size_positive").
model MediaObject {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contentItemId String      @db.Uuid
  role          MediaRole
  /// No user data in keys (spec §10.6).
  storageKey    String      @unique
  /// The verified type (content signature), never the browser's claim.
  mimeType      String
  sizeBytes     BigInt
  width         Int?
  height        Int?
  durationMs    Int?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, role])
}

/// One file on its way from a browser to storage (spec §7.3, §10): a guest's content frame
/// (`purpose = CONTENT`, with its guest session and link) or the admin's collection cover
/// (`purpose = COVER`, with `uploaderUserId`) [A1]. Rules live as named CHECKs:
/// "UploadSession_kind_is_file", "UploadSession_size_positive", "UploadSession_parts_positive",
/// "UploadSession_completed_consistent", "UploadSession_claim_consistent",
/// "UploadSession_reject_reason", "UploadSession_purpose_actor", "UploadSession_admin_image_is_photo";
/// open uploads per guest session use the partial index "UploadSession_active_idx". The guest
/// session and link belong to the row's own collection (composite keys). `INITIATED` rows
/// reserve `declaredSizeBytes` of quota (ADR 0010).
model UploadSession {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String             @db.Uuid
  purpose           UploadPurpose      @default(CONTENT)
  /// Admin image uploads only: what the upload completes into (set iff purpose <> CONTENT).
  imageTarget       ImageUploadTarget?
  /// CONTENT only. Deleting the guest session deletes its uploads; the idle sweep keeps sessions
  /// with uploads. Optional beside the required `collectionId` of its composite key (the
  /// `ContentItem.contributorGuestSession` precedent).
  guestSessionId    String?            @db.Uuid
  /// CONTENT only: the link the upload came through. NO ACTION (links are never deleted while
  /// referenced), so deleting the collection still cascades in one statement.
  guestLinkId       String?            @db.Uuid
  /// Admin images only (every purpose but CONTENT): the admin who uploads. Deleting the user
  /// deletes their image uploads.
  uploaderUserId    String?            @db.Uuid
  /// Chosen by the browser per file; initiation is idempotent on (guestSessionId, clientUploadId)
  /// for guests and (uploaderUserId, clientUploadId) for admins.
  clientUploadId    String             @db.Uuid
  kind              ContentKind
  originalFilename  String
  declaredMime      String
  declaredSizeBytes BigInt
  /// `collections/{collectionId}/uploads/{id}/original`.
  storageKey        String             @unique
  /// Every upload is multipart (ADR 0008 addendum 2026-10-03): storage's upload id.
  multipartUploadId String
  partSizeBytes     BigInt
  partCount         Int
  status            UploadStatus       @default(INITIATED)
  /// A stable error code when REJECTED.
  rejectReason      String?
  expiresAt         DateTime           @db.Timestamptz(3)
  completedAt       DateTime?          @db.Timestamptz(3)
  /// Set while COMPLETING (CHECK "UploadSession_claim_consistent").
  claimedAt         DateTime?          @db.Timestamptz(3)
  /// The item it became (CONTENT); NULL once that item is purged, and always for an admin image.
  contentItemId     String?            @unique @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  collection        Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  guestSession      GuestSession?      @relation(fields: [guestSessionId, collectionId], references: [id, collectionId], onDelete: Cascade, onUpdate: NoAction, map: "UploadSession_session_same_collection_fkey")
  guestLink         GuestLink?         @relation(fields: [guestLinkId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "UploadSession_link_same_collection_fkey")
  uploader          User?              @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  contentItem       ContentItem?       @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@unique([guestSessionId, clientUploadId])
  @@unique([uploaderUserId, clientUploadId])
  @@index([status, expiresAt])
  @@index([collectionId, status])
  @@index([guestLinkId])
}

/// A guest's report on a frame (slice 9, spec §7.4). Plain ids without foreign keys, so a report
/// outlives the content, collection and guest session it names, as abuse history. No IP is ever
/// stored. The reporter's e-mail (with their locale, CHECK "ContentReport_contact_consistent") is
/// kept only until the decision mail is sent, 90 days at most. One OPEN report per guest session
/// and item (partial unique "ContentReport_one_open_per_guest"); the admin's open reports use
/// "ContentReport_admin_open_idx". Rules live as named CHECKs: "ContentReport_resolved_consistent",
/// "ContentReport_description_length", "ContentReport_note_length", "ContentReport_email_length".
model ContentReport {
  id                     String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contentId              String       @db.Uuid
  collectionId           String       @db.Uuid
  reporterGuestSessionId String       @db.Uuid
  /// The client's `Idempotency-Key`; unique per guest session.
  idempotencyKey         String       @db.Uuid
  reason                 ReportReason
  description            String?
  reporterEmail          String?      @db.Citext
  reporterLocale         Locale?
  requestId              String?
  status                 ReportStatus @default(OPEN)
  /// The operator who decided; set with `resolvedAt` and `resolutionNote`.
  resolvedByUserId       String?      @db.Uuid
  resolvedAt             DateTime?    @db.Timestamptz(3)
  resolutionNote         String?
  /// The collection admin dismissed it for themselves ([Q1]); the operator still sees it OPEN.
  adminDismissedAt       DateTime?    @db.Timestamptz(3)
  /// The worker's mail jobs stamp these once sent, so a retried job sends nothing twice.
  operatorNotifiedAt     DateTime?    @db.Timestamptz(3)
  reporterNotifiedAt     DateTime?    @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([reporterGuestSessionId, idempotencyKey])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([contentId, status])
  @@index([collectionId])
}

/// A collection admin's appeal against the operator's measure (slice 9b, ADR 0013 addendum): on
/// a frame (hidden or quarantined by the operator) or on the blocked collection. Plain ids
/// without foreign keys, like reports: it outlives what it names. One OPEN appeal per target
/// (partial unique "ModerationAppeal_one_open_per_target"); a decided one allows a new one.
/// CHECKs: "ModerationAppeal_text_length" (1–1000), "ModerationAppeal_note_length" (1–500),
/// "ModerationAppeal_resolved_consistent" (OPEN ⇔ no decision time or decider),
/// "ModerationAppeal_rejection_note" (REJECTED has a note), "ModerationAppeal_open_has_no_note".
model ModerationAppeal {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId       String           @db.Uuid
  targetType         AppealTargetType
  targetId           String           @db.Uuid
  submittedByUserId  String           @db.Uuid
  /// The admin's text: user content the operator reads; never in logs or audit metadata.
  text               String
  status             AppealStatus     @default(OPEN)
  /// The operator who decided; set with `resolvedAt`.
  resolvedByUserId   String?          @db.Uuid
  resolvedAt         DateTime?        @db.Timestamptz(3)
  /// The operator's note the admin reads: required on REJECTED, optional on UPHELD.
  resolutionNote     String?
  requestId          String?
  /// The worker's mail job stamps it once the operator was told, so a retried job sends nothing twice.
  operatorNotifiedAt DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([collectionId, createdAt(sort: Desc)])
  @@index([submittedByUserId, createdAt])
}

/// Append-only. Plain ids without foreign keys, so events outlive what they describe (spec §7.4).
/// Metadata never holds user content (titles, descriptions, texts).
model AuditEvent {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String?        @db.Uuid
  actorType    AuditActorType
  actorId      String?        @db.Uuid
  action       String
  targetType   String
  targetId     String         @db.Uuid
  metadata     Json           @default("{}")
  requestId    String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([collectionId, createdAt])
  @@index([actorId, action, createdAt])
}

/// A sellable (or trial) offer (ADR 0018 [B10]): edited in /ops, deactivated, never deleted.
/// Which limits a kind needs: CHECK "BillingOffer_kind_shape". Purchases snapshot the limits.
model BillingOffer {
  id                     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                   String             @unique
  kind                   OfferKind
  /// Set iff kind = PACK_EXTENSION.
  extension              PackExtensionKind?
  rank                   Int                @default(0)
  /// Shown with «Найпопулярніший» on «Тарифи» and /pricing (billing page v4).
  highlighted            Boolean            @default(false)
  titleUk                String
  titleEn                String
  descriptionUk          String?
  descriptionEn          String?
  activeCollections      Int?
  storageBytes           BigInt?
  collectionStorageBytes BigInt?
  guestLinks             Int?
  windowDays             Int?
  retentionDays          Int?
  /// TRIAL only: how long a new account's trial lasts.
  durationDays           Int?
  /// Per-plan feature flags (B9), unused by the UI today.
  features               Json               @default("{}")
  /// The item id registered for fiscal receipts (plan [P14]); unused until then.
  rroItemId              String?
  active                 Boolean            @default(true)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  prices                 BillingPrice[]
  subscriptions          Subscription[]     @relation("SubscriptionOffer")
  pendingSubscriptions   Subscription[]     @relation("SubscriptionPendingOffer")
  packs                  CollectionPack[]
  payments               Payment[]
}

/// A price of one offer in one currency and period, in minor units (B2). One live price per
/// (offer, interval, currency) (partial unique "BillingPrice_one_active_per_slot").
model BillingPrice {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  offerId              String          @db.Uuid
  interval             BillingInterval
  currency             Currency
  /// Positive (CHECK "BillingPrice_amount_positive").
  amountMinor          Int
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  offer                BillingOffer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  subscriptions        Subscription[]  @relation("SubscriptionPrice")
  pendingSubscriptions Subscription[]  @relation("SubscriptionPendingPrice")
  payments             Payment[]

  @@index([offerId])
}

/// An account-level plan: a paid subscription or an operator's complimentary grant (plan [P1],
/// [P13]). Limits are a snapshot of the offer at start [B10]. At most one live per user (partial
/// unique "Subscription_one_live_per_user").
model Subscription {
  id                         String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                     String             @db.Uuid
  source                     SubscriptionSource
  status                     SubscriptionStatus
  offerId                    String             @db.Uuid
  priceId                    String?            @db.Uuid
  interval                   BillingInterval?
  amountMinor                Int?
  currency                   Currency?
  activeCollections          Int
  storageBytes               BigInt
  collectionStorageBytes     BigInt
  guestLinks                 Int
  features                   Json               @default("{}")
  currentPeriodStart         DateTime?          @db.Timestamptz(3)
  /// NULL = a grant without an end.
  currentPeriodEnd           DateTime?          @db.Timestamptz(3)
  graceEndsAt                DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd          Boolean            @default(false)
  canceledAt                 DateTime?          @db.Timestamptz(3)
  endedAt                    DateTime?          @db.Timestamptz(3)
  pendingOfferId             String?            @db.Uuid
  pendingPriceId             String?            @db.Uuid
  providerOrderId            String?            @unique
  autoRenewConsentAt         DateTime?          @db.Timestamptz(3)
  consentTermsVersion        String?
  /// The operator's reason for a grant; shown in /ops only.
  grantReason                String?
  grantedByUserId            String?            @db.Uuid
  /// The last `status` call for this subscription (reconciliation) and whether LiqPay answered.
  lastRefreshAt              DateTime?          @db.Timestamptz(3)
  lastRefreshOk              Boolean            @default(false)
  /// LiqPay confirmed it charges no more (our `unsubscribe`, or the payer at the bank).
  providerUnsubscribedAt     DateTime?          @db.Timestamptz(3)
  /// A new price LiqPay has not confirmed yet (`subscribe_update`); the reconcile job retries.
  pendingProviderAmountMinor Int?
  /// The period end whose failed renewal was mailed (one mail per period).
  renewalFailureNotifiedFor  DateTime?          @db.Timestamptz(3)
  /// The renewal check could not get an answer from LiqPay since then (archive or `status`
  /// down, or an ambiguous answer): the plan keeps its access and /ops shows «потребує
  /// перевірки». Cleared by the next answered check.
  renewalUnverifiedSince     DateTime?          @db.Timestamptz(3)
  createdAt                  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime           @updatedAt @db.Timestamptz(3)
  user                       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  offer                      BillingOffer       @relation("SubscriptionOffer", fields: [offerId], references: [id], onDelete: Restrict)
  price                      BillingPrice?      @relation("SubscriptionPrice", fields: [priceId], references: [id], onDelete: Restrict)
  pendingOffer               BillingOffer?      @relation("SubscriptionPendingOffer", fields: [pendingOfferId], references: [id], onDelete: Restrict)
  pendingPrice               BillingPrice?      @relation("SubscriptionPendingPrice", fields: [pendingPriceId], references: [id], onDelete: Restrict)
  payments                   Payment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, currentPeriodEnd], map: "Subscription_period_end_idx")
}

/// A one-time pack bought for one collection (ADR 0018 [B4], [P4]): its limits (snapshot) and
/// clocks. Deleted with its collection.
model CollectionPack {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId    String       @unique @db.Uuid
  offerId         String       @db.Uuid
  storageBytes    BigInt
  guestLinks      Int
  activatedAt     DateTime     @db.Timestamptz(3)
  windowEndsAt    DateTime     @db.Timestamptz(3)
  retentionEndsAt DateTime     @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  collection      Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  offer           BillingOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId])
}

/// One checkout and its money (ADR 0018, plan Task 11). The id is LiqPay's `order_id` [P8], kept
/// in `providerOrderId` too. Amount, currency and what was bought are snapshotted at checkout
/// [B10]; a payment survives its collection's purge (`collectionId` SET NULL). Rules as named
/// CHECKs: "Payment_amount_positive", "Payment_refund_bounds", "Payment_paid_consistent"; one
/// pending pack checkout per collection and offer ("Payment_one_pending_per_target").
model Payment {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String         @db.Uuid
  kind               PaymentKind
  status             PaymentStatus  @default(PENDING)
  offerId            String         @db.Uuid
  priceId            String?        @db.Uuid
  collectionId       String?        @db.Uuid
  subscriptionId     String?        @db.Uuid
  /// A pack that creates its collection (`collectionId` NULL at checkout): the title to use.
  newCollectionTitle String?
  amountMinor        Int
  currency           Currency
  /// What was bought: the offer's code, kind, titles and limits at checkout.
  offerSnapshot      Json
  providerOrderId    String         @unique
  providerPaymentId  String?        @unique
  expiresAt          DateTime       @db.Timestamptz(3)
  paidAt             DateTime?      @db.Timestamptz(3)
  failedAt           DateTime?      @db.Timestamptz(3)
  errCode            String?
  refundedMinor      Int            @default(0)
  /// A success that could not be granted as bought (e.g. a second pack): for the operator.
  needsReview        Boolean        @default(false)
  /// The provider reported another amount or currency: nothing was granted.
  mismatch           Boolean        @default(false)
  /// The last `status` call for this payment (the return page's refresh is throttled by it).
  lastCheckedAt      DateTime?      @db.Timestamptz(3)
  /// A subscription payment: the paid period (a renewal's new period, an upgrade's current one).
  periodStart        DateTime?      @db.Timestamptz(3)
  periodEnd          DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  offer              BillingOffer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  price              BillingPrice?  @relation(fields: [priceId], references: [id], onDelete: Restrict)
  collection         Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  subscription       Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  events             PaymentEvent[]
  refunds            Refund[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([collectionId])
  @@index([offerId])
  @@index([priceId])
  @@index([subscriptionId])
}

/// A verified provider callback (plan Task 12). Unverified bodies are never stored. `dedupeKey`
/// is the SHA-256 of the raw `data` string, so a replay is one row; the raw string itself is
/// discarded. `payload` keeps whitelisted fields only (no names, phone, IP or card data). An
/// event whose transition failed stays `processedAt` NULL until the reconciliation job reapplies
/// it (partial index "PaymentEvent_unprocessed_idx").
model PaymentEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider    String    @default("liqpay")
  dedupeKey   String    @unique
  verified    Boolean
  orderId     String?
  paymentId   String?   @db.Uuid
  payload     Json
  /// `applied` | `noop` | `mismatch` | `review` | `unknown_order`.
  outcome     String?
  processedAt DateTime? @db.Timestamptz(3)
  error       String?
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

/// A refund the operator made from /ops (owner decision B11, plan Task 21): full or partial,
/// with a reason, audited. `Idempotency-Key` per form: one refund per (payment, key). Rules as
/// named CHECKs: "Refund_amount_positive", "Refund_reason_length", "Refund_completed_consistent";
/// pending refunds are found through "Refund_pending_idx".
model Refund {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId      String       @db.Uuid
  amountMinor    Int
  currency       Currency
  status         RefundStatus @default(PENDING)
  reason         String
  operatorUserId String       @db.Uuid
  idempotencyKey String       @db.Uuid
  /// LiqPay's answer (`reversed`, `error`, …); never a card detail.
  providerStatus String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  operator       User         @relation(fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@index([operatorUserId])
}
