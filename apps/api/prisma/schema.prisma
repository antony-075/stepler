// Identity (spec §7.1), collections, guest links and audit (§7.2, §7.4). Constraints the schema cannot express (citext extension, CHECKs,
// partial indexes) live as named raw SQL in the migrations (ADR 0005, spike S6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uk
  en
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
  /// Deletion requested: gone for everyone; the purge job removes the rows (D2).
  DELETING
}

enum GuestLinkStatus {
  ACTIVE
  /// Paused by the admin; can be resumed.
  INACTIVE
  /// Terminal: revoked, or rotated out (a default link). The token ciphertext is wiped.
  REVOKED
}

enum AuditActorType {
  ADMIN
  OPERATOR
  GUEST
  SYSTEM
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

model User {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String        @unique @db.Citext
  emailVerifiedAt DateTime?     @db.Timestamptz(3)
  /// At most 80 characters (CHECK "User_displayName_length").
  displayName     String?
  locale          Locale        @default(uk)
  /// BLOCKED if and only if blockedAt is set (CHECK "User_blocked_consistent").
  status          UserStatus    @default(ACTIVE)
  blockedAt       DateTime?     @db.Timestamptz(3)
  blockedReason   String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  accounts        AuthAccount[]
  sessions        AuthSession[]
  collections     Collection[]
}

model AuthAccount {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLinkToken {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String    @db.Citext
  /// SHA-256 of the emailed token; the raw token is never stored.
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  locale        Locale
  /// HMAC-SHA256 of the requesting IP (HKDF key "ip-hash"); for abuse investigation only.
  requestIpHash String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
}

model Collection {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId             String           @db.Uuid
  /// 1 to 100 characters (CHECK "Collection_title_length").
  title               String
  /// 1 to 1000 characters when set (CHECK "Collection_description_length").
  description         String?
  /// ARCHIVED iff archivedAt is set, DELETING iff deletionRequestedAt is set
  /// (CHECKs "Collection_archived_consistent", "Collection_deleting_consistent").
  status              CollectionStatus @default(ACTIVE)
  archivedAt          DateTime?        @db.Timestamptz(3)
  deletionRequestedAt DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  guestLinks          GuestLink[]

  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)])
}

/// A public entry point to a collection (ADR 0007, spec §7.2). Rules live as named CHECKs:
/// "GuestLink_has_capability", "GuestLink_delete_own_needs_contribution",
/// "GuestLink_revoked_consistent", "GuestLink_ciphertext_while_live",
/// "GuestLink_replaced_only_revoked", "GuestLink_label_rules",
/// "GuestLink_hidden_only_revoked_additional"; at most one non-revoked default
/// link per collection (partial unique index "GuestLink_one_live_default").
model GuestLink {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId    String          @db.Uuid
  isDefault       Boolean
  /// Additional links only, 1 to 60 characters; the default link has none.
  label           String?
  status          GuestLinkStatus @default(ACTIVE)
  revokedAt       DateTime?       @db.Timestamptz(3)
  /// Set when the owner deletes an additional link: revoked and no longer listed. The row stays,
  /// so audit events and (later) guest content keep pointing at it.
  hiddenAt        DateTime?       @db.Timestamptz(3)
  /// Set on a rotated-out default link: the link that replaced it.
  replacedById    String?         @unique @db.Uuid
  /// SHA-256 of the token, for lookup. The raw token is never stored in clear.
  tokenHash       String          @unique
  /// AES-256-GCM of the token so the owner can see the link again; NULL once revoked.
  tokenCiphertext String?
  tokenKeyId      String?
  canUploadPhotos    Boolean
  canUploadVideos    Boolean
  canUploadDocuments Boolean
  canSubmitText   Boolean
  canViewGallery  Boolean
  canDeleteOwn    Boolean
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  collection      Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  replacedBy      GuestLink?      @relation("LinkRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces        GuestLink?      @relation("LinkRotation")

  @@index([collectionId, isDefault, status, createdAt])
}

/// Append-only. Plain ids without foreign keys, so events outlive what they describe (spec §7.4).
/// Metadata never holds user content (titles, descriptions, texts).
model AuditEvent {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String?        @db.Uuid
  actorType    AuditActorType
  actorId      String?        @db.Uuid
  action       String
  targetType   String
  targetId     String         @db.Uuid
  metadata     Json           @default("{}")
  requestId    String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([collectionId, createdAt])
  @@index([actorId, action, createdAt])
}
