// Identity (spec §7.1), collections and audit (§7.2, §7.4). Constraints the schema cannot express (citext extension, CHECKs,
// partial indexes) live as named raw SQL in the migrations (ADR 0005, spike S6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uk
  en
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
  /// Deletion requested: gone for everyone; the purge job removes the rows (D2).
  DELETING
}

enum AuditActorType {
  ADMIN
  OPERATOR
  GUEST
  SYSTEM
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

model User {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String        @unique @db.Citext
  emailVerifiedAt DateTime?     @db.Timestamptz(3)
  /// At most 80 characters (CHECK "User_displayName_length").
  displayName     String?
  locale          Locale        @default(uk)
  /// BLOCKED if and only if blockedAt is set (CHECK "User_blocked_consistent").
  status          UserStatus    @default(ACTIVE)
  blockedAt       DateTime?     @db.Timestamptz(3)
  blockedReason   String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  accounts        AuthAccount[]
  sessions        AuthSession[]
  collections     Collection[]
}

model AuthAccount {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLinkToken {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String    @db.Citext
  /// SHA-256 of the emailed token; the raw token is never stored.
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  locale        Locale
  /// HMAC-SHA256 of the requesting IP (HKDF key "ip-hash"); for abuse investigation only.
  requestIpHash String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
}

model Collection {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId             String           @db.Uuid
  /// 1 to 100 characters (CHECK "Collection_title_length").
  title               String
  /// 1 to 1000 characters when set (CHECK "Collection_description_length").
  description         String?
  /// ARCHIVED iff archivedAt is set, DELETING iff deletionRequestedAt is set
  /// (CHECKs "Collection_archived_consistent", "Collection_deleting_consistent").
  status              CollectionStatus @default(ACTIVE)
  archivedAt          DateTime?        @db.Timestamptz(3)
  deletionRequestedAt DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)])
}

/// Append-only. Plain ids without foreign keys, so events outlive what they describe (spec §7.4).
/// Metadata never holds user content (titles, descriptions, texts).
model AuditEvent {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String?        @db.Uuid
  actorType    AuditActorType
  actorId      String?        @db.Uuid
  action       String
  targetType   String
  targetId     String         @db.Uuid
  metadata     Json           @default("{}")
  requestId    String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([collectionId, createdAt])
  @@index([actorId, action, createdAt])
}
