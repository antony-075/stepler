// Identity (spec §7.1), collections, guest links, guest sessions, content and audit (§7.2–§7.4). Constraints the schema cannot express (citext extension, CHECKs,
// partial indexes) live as named raw SQL in the migrations (ADR 0005, spike S6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uk
  en
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
  /// Deletion requested: gone for everyone; the purge job removes the rows (D2).
  DELETING
}

enum GuestLinkStatus {
  ACTIVE
  /// Paused by the admin; can be resumed.
  INACTIVE
  /// Terminal: revoked, or rotated out (a default link). The token ciphertext is wiped.
  REVOKED
}

enum ContentKind {
  PHOTO
  VIDEO
  DOCUMENT
  TEXT
}

/// TEXT and DOCUMENT are NOT_REQUIRED; PHOTO and VIDEO stay PENDING until the worker finishes
/// (CHECK "ContentItem_processing_by_kind").
enum ProcessingStatus {
  NOT_REQUIRED
  PENDING
  READY
  FAILED
}

/// A cover is PENDING until the worker made its derivatives (CHECK "CollectionCover_ready_dimensions").
enum CoverStatus {
  PENDING
  READY
  FAILED
}

/// Where the cover's original came from: the admin's own upload, or a copy of a guest photo frame.
enum CoverSource {
  UPLOAD
  FRAME
}

/// What an upload becomes: a guest's content frame, or one of the admin's images: the guest page
/// cover, its background, or the admin-only collection image [A1]
/// (CHECKs "UploadSession_purpose_actor", "UploadSession_admin_image_is_photo").
enum UploadPurpose {
  CONTENT
  COVER
  BACKGROUND
  COLLECTION_IMAGE
}

/// Which admin image an image row is (plan 2026-10-05, ADR 0017). The slot decides its storage
/// prefix and its renditions; rows are referenced by guest page versions or the collection.
enum ImageSlot {
  COVER
  BACKGROUND
  COLLECTION_IMAGE
}

/// PENDING until the worker made its renditions (CHECK "CollectionImage_ready_dimensions").
enum ImageStatus {
  PENDING
  READY
  FAILED
}

/// Where an image's original came from: the admin's own upload, or a copy of a guest photo frame.
enum ImageSource {
  UPLOAD
  FRAME
}

/// A collection has one PUBLISHED guest page (what guests see) and at most one DRAFT (the editor's).
enum GuestPageVersionState {
  PUBLISHED
  DRAFT
}

enum UploadStatus {
  INITIATED
  /// A completion claimed it (`claimedAt`) and is checking storage outside any transaction; a
  /// claim older than a few minutes (a crashed completion) can be claimed again or expired.
  COMPLETING
  COMPLETED
  /// Cancelled by the guest, or by the collection's purge.
  ABORTED
  /// Not completed within its TTL; the expiry job discards its bytes.
  EXPIRED
  /// Completion refused (type, size, permission or state); the bytes are discarded.
  REJECTED
}

enum MediaRole {
  ORIGINAL
  THUMBNAIL
  PREVIEW
  POSTER
}

enum AuditActorType {
  ADMIN
  OPERATOR
  GUEST
  SYSTEM
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

/// Legal documents (registry in @stepler/contracts `LEGAL_DOCUMENTS`; ADR 0016).
enum LegalDocument {
  TERMS
  PRIVACY
}

model User {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email            String            @unique @db.Citext
  emailVerifiedAt  DateTime?         @db.Timestamptz(3)
  /// At most 80 characters (CHECK "User_displayName_length").
  displayName      String?
  locale           Locale            @default(uk)
  /// BLOCKED if and only if blockedAt is set (CHECK "User_blocked_consistent").
  status           UserStatus        @default(ACTIVE)
  blockedAt        DateTime?         @db.Timestamptz(3)
  blockedReason    String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  accounts         AuthAccount[]
  sessions         AuthSession[]
  collections      Collection[]
  uploadSessions   UploadSession[]
  legalAcceptances LegalAcceptance[]
}

model AuthAccount {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One acceptance of one version of a legal document (spec §7.1, ADR 0016). No IP address is
/// stored (owner decision L2); `requestId` correlates the row with the request log. The version
/// is one of the registry's (CHECK "LegalAcceptance_version_format").
model LegalAcceptance {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String        @db.Uuid
  document   LegalDocument
  version    String
  acceptedAt DateTime      @default(now()) @db.Timestamptz(3)
  requestId  String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
}

model MagicLinkToken {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String    @db.Citext
  /// SHA-256 of the emailed token; the raw token is never stored.
  tokenHash           String    @unique
  expiresAt           DateTime  @db.Timestamptz(3)
  consumedAt          DateTime? @db.Timestamptz(3)
  locale              Locale
  /// HMAC-SHA256 of the requesting IP (HKDF key "ip-hash"); for abuse investigation only.
  requestIpHash       String?
  /// Legal versions accepted on the sign-in card (ADR 0016), recorded at verify. NULL on links
  /// issued before slice 10 (nothing is recorded). CHECK "MagicLinkToken_legal_versions_format".
  legalTermsVersion   String?
  legalPrivacyVersion String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
}

model Collection {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId             String             @db.Uuid
  /// 1 to 100 characters (CHECK "Collection_title_length").
  title               String
  /// 1 to 1000 characters when set (CHECK "Collection_description_length").
  description         String?
  /// Shown to guests above their main action; 1 to 160 code points when set
  /// (CHECK "Collection_welcome_length") [A5].
  welcomeMessage      String?
  /// ARCHIVED iff archivedAt is set, DELETING iff deletionRequestedAt is set
  /// (CHECKs "Collection_archived_consistent", "Collection_deleting_consistent").
  status              CollectionStatus   @default(ACTIVE)
  archivedAt          DateTime?          @db.Timestamptz(3)
  deletionRequestedAt DateTime?          @db.Timestamptz(3)
  /// The next frame number (ADR 0015); taken and incremented in the transaction that creates an
  /// item. Gaps are never filled. At least 1 (CHECK "Collection_next_frame_positive").
  nextFrameNo         Int                @default(1)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  guestLinks          GuestLink[]
  guestSessions       GuestSession[]
  contentItems        ContentItem[]
  uploadSessions      UploadSession[]
  cover               CollectionCover?
  /// «Картинка колекції»: the owner's own image of the collection (dashboard, share dialog);
  /// never in a guest response. An image of this collection (composite key), NO ACTION so
  /// deleting the collection still cascades in one statement.
  imageId             String?            @db.Uuid
  image               CollectionImage?   @relation("CollectionImageOfCollection", fields: [imageId, id], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "Collection_image_same_collection_fkey")
  images              CollectionImage[]  @relation("CollectionImages")
  guestPageVersions   GuestPageVersion[]

  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)])
}

/// An admin image of a collection (plan 2026-10-05, ADR 0017): a guest page cover or background,
/// or the collection image. Rows are immutable apart from the worker's READY/FAILED; a replaced
/// image is a new row. A row lives while a guest page version or the collection references it;
/// the transaction that drops the last reference deletes it and queues `collection-image.purge`.
/// Keys come from ids only: `imageKey(collectionId, slot, id, role)`. Rules live as named CHECKs:
/// "CollectionImage_sizes", "CollectionImage_ready_dimensions".
model CollectionImage {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String             @db.Uuid
  slot              ImageSlot
  status            ImageStatus        @default(PENDING)
  source            ImageSource
  /// The verified type of the original (content signature), never the browser's claim.
  mimeType          String
  originalSizeBytes BigInt
  /// Every rendition of the slot; 0 until READY. They count toward usage with the original.
  derivedSizeBytes  BigInt             @default(0)
  /// The source's upright dimensions, set with READY.
  width             Int?
  height            Int?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  collection        Collection         @relation("CollectionImages", fields: [collectionId], references: [id], onDelete: Cascade)
  asCollectionImage Collection[]       @relation("CollectionImageOfCollection")
  asCover           GuestPageVersion[] @relation("GuestPageCover")
  asBackground      GuestPageVersion[] @relation("GuestPageBackground")

  @@unique([id, collectionId])
  @@index([collectionId, slot])
}

/// One version of a collection's guest page (plan 2026-10-05, ADR 0017): the PUBLISHED one guests
/// see and, while the admin edits, one DRAFT ("GuestPageVersion_collectionId_state_key"). Settings
/// are validated by the template's definition before they are stored, and resolved again on read.
/// The images belong to the same collection (composite keys, NO ACTION). `revision` is the
/// draft's optimistic-concurrency counter. Rules live as named CHECKs:
/// "GuestPageVersion_template_id", "GuestPageVersion_numbers",
/// "GuestPageVersion_settings_object", "GuestPageVersion_welcome_length".
model GuestPageVersion {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String                @db.Uuid
  state             GuestPageVersionState
  templateId        String
  templateVersion   Int
  settings          Json
  /// Shown to guests above their main action; 1 to 160 code points when set [A5].
  welcomeMessage    String?
  coverImageId      String?               @db.Uuid
  backgroundImageId String?               @db.Uuid
  revision          Int                   @default(1)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  collection        Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  coverImage        CollectionImage?      @relation("GuestPageCover", fields: [coverImageId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "GuestPageVersion_cover_same_collection_fkey")
  backgroundImage   CollectionImage?      @relation("GuestPageBackground", fields: [backgroundImageId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "GuestPageVersion_background_same_collection_fkey")

  @@unique([collectionId, state])
  @@index([coverImageId])
  @@index([backgroundImageId])
}

/// The collection's cover [A2]: one row per collection, replaced whole (a replaced or removed
/// cover's row is deleted at once and its objects purged by `cover.purge`). No storage keys here:
/// every key is `coverKey(collectionId, id, role)`. Rules live as named CHECKs:
/// "CollectionCover_sizes", "CollectionCover_ready_dimensions".
model CollectionCover {
  id                String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String      @unique @db.Uuid
  status            CoverStatus @default(PENDING)
  source            CoverSource
  /// The verified type of the original (content signature), never the browser's claim.
  mimeType          String
  originalSizeBytes BigInt
  /// Thumbnail plus preview; 0 until READY. Both count toward usage with the original.
  derivedSizeBytes  BigInt      @default(0)
  /// The source's upright dimensions, set with READY.
  width             Int?
  height            Int?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  collection        Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

/// A public entry point to a collection (ADR 0007, spec §7.2). Rules live as named CHECKs:
/// "GuestLink_has_capability", "GuestLink_delete_own_needs_contribution",
/// "GuestLink_revoked_consistent", "GuestLink_ciphertext_while_live",
/// "GuestLink_replaced_only_revoked", "GuestLink_label_rules",
/// "GuestLink_hidden_only_revoked_additional"; at most one non-revoked default
/// link per collection (partial unique index "GuestLink_one_live_default").
model GuestLink {
  id                 String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId       String          @db.Uuid
  isDefault          Boolean
  /// Additional links only, 1 to 60 characters; the default link has none.
  label              String?
  status             GuestLinkStatus @default(ACTIVE)
  revokedAt          DateTime?       @db.Timestamptz(3)
  /// Set when the owner deletes an additional link: revoked and no longer listed. The row stays,
  /// so audit events and (later) guest content keep pointing at it.
  hiddenAt           DateTime?       @db.Timestamptz(3)
  /// Set on a rotated-out default link: the link that replaced it.
  replacedById       String?         @unique @db.Uuid
  /// SHA-256 of the token, for lookup. The raw token is never stored in clear.
  tokenHash          String          @unique
  /// AES-256-GCM of the token so the owner can see the link again; NULL once revoked.
  tokenCiphertext    String?
  tokenKeyId         String?
  canUploadPhotos    Boolean
  canUploadVideos    Boolean
  canUploadDocuments Boolean
  canSubmitText      Boolean
  canViewGallery     Boolean
  canDeleteOwn       Boolean
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  collection         Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  replacedBy         GuestLink?      @relation("LinkRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces           GuestLink?      @relation("LinkRotation")
  guestSessions      GuestSession[]
  uploadSessions     UploadSession[]

  @@unique([id, collectionId])
  @@index([collectionId, isDefault, status, createdAt])
}

/// A guest's browser in one collection (ADR 0007, spec §7.2): the `st_gs` cookie holds the raw
/// token. Bound to the link it last came through; every request re-checks that link and the
/// collection. The name is optional, asked once [O4]; 1 to 80 characters when set
/// (CHECK "GuestSession_name_length").
model GuestSession {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId    String          @db.Uuid
  /// A link of the same collection (composite key with "collectionId"). A link with sessions is
  /// never deleted (links are revoked and hidden instead). NO ACTION, not RESTRICT, so deleting
  /// the collection still cascades to both in one statement.
  currentLinkId   String          @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash       String          @unique
  contributorName String?
  /// Set when the guest saved or skipped the name prompt, so it is asked once per session.
  nameAnsweredAt  DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime        @default(now()) @db.Timestamptz(3)
  collection      Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  currentLink     GuestLink       @relation(fields: [currentLinkId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "GuestSession_link_same_collection_fkey")
  contentItems    ContentItem[]
  uploadSessions  UploadSession[]

  @@unique([id, collectionId])
  @@index([collectionId])
  @@index([currentLinkId])
}

/// One frame: a text now, files later (spec §7.3). Rules live as named CHECKs:
/// "ContentItem_text_consistent", "ContentItem_text_length", "ContentItem_name_length",
/// "ContentItem_frame_positive", "ContentItem_processing_by_kind"; the feed, own and purge
/// indexes are partial ("ContentItem_feed_idx", "ContentItem_feed_kind_idx",
/// "ContentItem_own_idx", "ContentItem_deleted_idx").
model ContentItem {
  id                        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId              String           @db.Uuid
  /// Per-collection number shown as #086 (ADR 0015); never reused.
  frameNo                   Int
  kind                      ContentKind
  /// A session of the same collection (composite key with "collectionId"); only this column is
  /// nulled once the session row is gone (`SET NULL ("contributorGuestSessionId")` in the
  /// migration; Prisma warns about SetNull on a key with a required field). The item stays.
  contributorGuestSessionId String?          @db.Uuid
  /// Snapshot of the session's name when the item was created; renaming updates live items [C4].
  contributorName           String?
  originalFilename          String?
  /// TEXT items only, 1 to 5000 code points.
  textBody                  String?
  /// The client's `Idempotency-Key` for texts; unique per session.
  idempotencyKey            String?          @db.Uuid
  processingStatus          ProcessingStatus
  /// Soft delete: hidden at once, purged by the worker.
  deletedAt                 DateTime?        @db.Timestamptz(3)
  createdAt                 DateTime         @default(now()) @db.Timestamptz(3)
  collection                Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contributorGuestSession   GuestSession?    @relation(fields: [contributorGuestSessionId, collectionId], references: [id, collectionId], onDelete: SetNull, onUpdate: NoAction, map: "ContentItem_session_same_collection_fkey")
  mediaObjects              MediaObject[]
  uploadSession             UploadSession?

  @@unique([collectionId, frameNo])
  @@unique([contributorGuestSessionId, idempotencyKey])
}

/// A stored file of a content item (spec §7.3): the ORIGINAL as uploaded (immutable), and the
/// derivatives the worker makes (disposable). Sizes are positive (CHECK "MediaObject_size_positive").
model MediaObject {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contentItemId String      @db.Uuid
  role          MediaRole
  /// No user data in keys (spec §10.6).
  storageKey    String      @unique
  /// The verified type (content signature), never the browser's claim.
  mimeType      String
  sizeBytes     BigInt
  width         Int?
  height        Int?
  durationMs    Int?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, role])
}

/// One file on its way from a browser to storage (spec §7.3, §10): a guest's content frame
/// (`purpose = CONTENT`, with its guest session and link) or the admin's collection cover
/// (`purpose = COVER`, with `uploaderUserId`) [A1]. Rules live as named CHECKs:
/// "UploadSession_kind_is_file", "UploadSession_size_positive", "UploadSession_parts_positive",
/// "UploadSession_completed_consistent", "UploadSession_claim_consistent",
/// "UploadSession_reject_reason", "UploadSession_purpose_actor", "UploadSession_admin_image_is_photo";
/// open uploads per guest session use the partial index "UploadSession_active_idx". The guest
/// session and link belong to the row's own collection (composite keys). `INITIATED` rows
/// reserve `declaredSizeBytes` of quota (ADR 0010).
model UploadSession {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId      String        @db.Uuid
  purpose           UploadPurpose @default(CONTENT)
  /// CONTENT only. Deleting the guest session deletes its uploads; the idle sweep keeps sessions
  /// with uploads. Optional beside the required `collectionId` of its composite key (the
  /// `ContentItem.contributorGuestSession` precedent).
  guestSessionId    String?       @db.Uuid
  /// CONTENT only: the link the upload came through. NO ACTION (links are never deleted while
  /// referenced), so deleting the collection still cascades in one statement.
  guestLinkId       String?       @db.Uuid
  /// Admin images only (every purpose but CONTENT): the admin who uploads. Deleting the user
  /// deletes their image uploads.
  uploaderUserId    String?       @db.Uuid
  /// Chosen by the browser per file; initiation is idempotent on (guestSessionId, clientUploadId)
  /// for guests and (uploaderUserId, clientUploadId) for admins.
  clientUploadId    String        @db.Uuid
  kind              ContentKind
  originalFilename  String
  declaredMime      String
  declaredSizeBytes BigInt
  /// `collections/{collectionId}/uploads/{id}/original`.
  storageKey        String        @unique
  /// Every upload is multipart (ADR 0008 addendum 2026-10-03): storage's upload id.
  multipartUploadId String
  partSizeBytes     BigInt
  partCount         Int
  status            UploadStatus  @default(INITIATED)
  /// A stable error code when REJECTED.
  rejectReason      String?
  expiresAt         DateTime      @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  /// Set while COMPLETING (CHECK "UploadSession_claim_consistent").
  claimedAt         DateTime?     @db.Timestamptz(3)
  /// The item it became (CONTENT); NULL once that item is purged, and always for an admin image.
  contentItemId     String?       @unique @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  collection        Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  guestSession      GuestSession? @relation(fields: [guestSessionId, collectionId], references: [id, collectionId], onDelete: Cascade, onUpdate: NoAction, map: "UploadSession_session_same_collection_fkey")
  guestLink         GuestLink?    @relation(fields: [guestLinkId, collectionId], references: [id, collectionId], onDelete: NoAction, onUpdate: NoAction, map: "UploadSession_link_same_collection_fkey")
  uploader          User?         @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  contentItem       ContentItem?  @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@unique([guestSessionId, clientUploadId])
  @@unique([uploaderUserId, clientUploadId])
  @@index([status, expiresAt])
  @@index([collectionId, status])
  @@index([guestLinkId])
}

/// Append-only. Plain ids without foreign keys, so events outlive what they describe (spec §7.4).
/// Metadata never holds user content (titles, descriptions, texts).
model AuditEvent {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String?        @db.Uuid
  actorType    AuditActorType
  actorId      String?        @db.Uuid
  action       String
  targetType   String
  targetId     String         @db.Uuid
  metadata     Json           @default("{}")
  requestId    String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([collectionId, createdAt])
  @@index([actorId, action, createdAt])
}
