# Names only, with local development values. Copy to .env; never commit .env.
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://stepler:stepler-local@127.0.0.1:5433/stepler
# Prisma CLI only (db:migrate, db:check); Prisma resets this database.
SHADOW_DATABASE_URL=postgresql://stepler:stepler-local@127.0.0.1:5433/stepler_shadow
# COOKIE_SECURE=false
# SESSION_TTL_DAYS=30
# MAGIC_LINK_TTL_MINUTES=15
OPERATOR_EMAILS=
API_TRUST_PROXY=false
# Generate with: openssl rand -base64 32
APP_SECRET=
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Stepler <no-reply@stepler.local>
# Cloudflare's documented always-pass test keys; real keys are per environment.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Leave both empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=stepler-dev
S3_ACCESS_KEY_ID=stepler
S3_SECRET_ACCESS_KEY=stepler-local-secret
S3_FORCE_PATH_STYLE=true
# Limits (defaults shown in docs/development/README.md) can be overridden here.
# LIMIT_COLLECTION_CREATIONS_PER_DAY=10
# LIMIT_GUEST_LINKS_PER_COLLECTION=10
# LIMIT_GUEST_LINK_RESOLVE_PER_IP_PER_MINUTE=120
# LIMIT_GUEST_SESSIONS_PER_IP_PER_MINUTE=120
# LIMIT_FILE_BYTES_PHOTO=50000000
# LIMIT_FILE_BYTES_VIDEO=2000000000
# LIMIT_FILE_BYTES_DOCUMENT=50000000
# LIMIT_FILES_PER_BATCH=100
# LIMIT_TEXTS_PER_GUEST_SESSION_PER_HOUR=60
# LIMIT_UPLOAD_INITIATIONS_PER_GUEST_SESSION_PER_HOUR=300
# LIMIT_CONCURRENT_UPLOADS_PER_GUEST_SESSION=10
# LIMIT_TEXTS_PER_IP_PER_MINUTE=60
# LIMIT_GUEST_READS_PER_IP_PER_MINUTE=600
# Worker only (`pnpm worker:dev` reads this file too).
# WORKER_MEDIA_CONCURRENCY=1
# WORKER_PURGE_BATCH_SIZE=500
# GUEST_SESSION_IDLE_DAYS=400
