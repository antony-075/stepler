{
  "name": "@stepler/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "build:e2e": "nest build -p tsconfig.build-e2e.json",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "worker:dev": "nest start --watch -p tsconfig.build-worker.json --entryFile worker/main --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi:write": "OPENAPI_WRITE=1 vitest run test/openapi.spec.ts",
    "openapi:check": "vitest run test/openapi.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "storage:bootstrap": "node --env-file-if-exists=../../docker/.env.example --env-file-if-exists=../../docker/.env --env-file-if-exists=.env scripts/storage-bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/s3-request-presigner": "3.1153.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@stepler/contracts": "workspace:*",
    "@stepler/templates": "workspace:*",
    "arctic": "3.7.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "catalog:",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@stepler/config": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "catalog:",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
