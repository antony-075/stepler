{
  "components": {
    "schemas": {
      "ProblemDetails": {
        "additionalProperties": {},
        "properties": {
          "code": {
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CSRF_ORIGIN_MISMATCH",
              "RATE_LIMITED",
              "TURNSTILE_FAILED",
              "MAGIC_LINK_INVALID",
              "OAUTH_FAILED",
              "ACCOUNT_BLOCKED",
              "UPSTREAM_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "INTERNAL"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "type": "string"
                },
                "path": {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "retryable"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "st_session": {
        "in": "cookie",
        "name": "st_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Stepler API",
    "version": "1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out; the session cookie is cleared"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Error (RFC 9457 problem details; `code` is stable, see ERROR_CODES)"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
