{
  "name": "@stepler/templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": "./src/react/index.ts",
    "./styles.css": "./src/styles.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "src",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc -w -p tsconfig.build.json --preserveWatchOutput",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@stepler/contracts": "workspace:*",
    "@stepler/ui": "workspace:*",
    "lucide-react": "1.52.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stepler/config": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
