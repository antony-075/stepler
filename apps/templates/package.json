{
  "name": "@stepler/templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc -w -p tsconfig.build.json --preserveWatchOutput"
  },
  "dependencies": {
    "@stepler/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stepler/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
