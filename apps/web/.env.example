# Names only. Copy to .env for local development; never commit .env.
# Where the web server forwards same-origin /api/* requests (read at runtime).
API_INTERNAL_URL=http://localhost:4000
# Behind an edge that sets the client IP in a header it overwrites (Render: cf-connecting-ip).
# CLIENT_IP_HEADER=cf-connecting-ip
# Contact for privacy requests and content complaints, shown on /legal/* (spec §15).
# LEGAL_CONTACT_EMAIL=privacy@example.com
# Allows placeholder legal texts and a missing contact. Never set in production: the server
# refuses to start on drafts ([C20]). `next dev` always allows them.
# LEGAL_ALLOW_DRAFT=true
# Production only: lets search engines index the public pages. Unset/off: every page is noindex.
# SEARCH_INDEXING=on
