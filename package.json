{
  "name": "stepler-app",
  "private": true,
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "worker:dev": "turbo run worker:dev --filter @stepler/api",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "landing:media": "pnpm --filter @stepler/e2e exec playwright test -c media/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build-storybook": "turbo run build-storybook",
    "infra:up": "docker compose -f docker/compose.yaml --env-file docker/.env up -d --wait",
    "infra:down": "docker compose -f docker/compose.yaml --env-file docker/.env down",
    "mailpit": "docker compose -f docker/compose.yaml --env-file docker/.env up -d --wait mailpit && echo 'Mailpit: http://127.0.0.1:8025' && (open http://127.0.0.1:8025 || xdg-open http://127.0.0.1:8025 || true)",
    "storage:bootstrap": "pnpm --filter @stepler/api storage:bootstrap",
    "storybook": "pnpm --filter @stepler/ui storybook",
    "templates:dev": "pnpm --filter @stepler/templates storybook",
    "db:migrate": "pnpm --filter @stepler/api db:migrate",
    "db:deploy": "pnpm --filter @stepler/api db:deploy",
    "db:studio": "pnpm --filter @stepler/api db:studio",
    "db:check": "pnpm --filter @stepler/api db:check",
    "openapi:write": "pnpm --filter @stepler/api openapi:write",
    "release:check": "pnpm format:check && pnpm turbo run lint typecheck test build build-storybook && pnpm e2e && bash docker/scripts/verify-images.sh"
  },
  "devDependencies": {
    "@stepler/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "catalog:"
  }
}
